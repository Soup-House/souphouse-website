---
// An event card in a news post, like the "Our events" block: name, date and
// time, place, menu, and "Sign up to help" when it takes volunteers.
interface Props { title: string; when?: string; place?: string; menu?: string; signup?: string }
const { title, when, place, menu, signup } = Astro.props
// Signup links point at www.souphouse.org; keep them on this site (staging too).
const href = signup?.replace(/^https:\/\/(www\.)?souphouse\.org/, '') ?? ''
---
<div class="not-prose bg-base-200 my-5 rounded-2xl p-5 shadow-sm">
  <h3 class="font-heading text-2xl leading-tight" style="color: var(--post-accent)">{title}</h3>
  {when && <p class="mt-1 font-semibold">{when}</p>}
  {place && <p class="text-base-content/70">{place}</p>}
  {menu && <p class="mt-2"><strong>On the menu:</strong> {menu}</p>}
  {href && <a class="btn btn-primary btn-sm mt-4" href={href}>Sign up to help</a>}
</div>
