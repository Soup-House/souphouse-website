---
interface Props { src: string; alt?: string; caption?: string }
const { src, alt = '', caption } = Astro.props
---
<figure class="not-prose my-8">
  <img src={src} alt={alt} loading="lazy" decoding="async" class="w-full rounded-2xl shadow-sm" />
  {caption && <figcaption class="text-base-content/60 mt-2 text-center text-sm">{caption}</figcaption>}
</figure>
